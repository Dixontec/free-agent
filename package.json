{
  "name": "free-agent",
  "productName": "Free Agent",
  "version": "1.0.1",
  "description": "Free Agent — local-first AI harness",
  "author": "Dixontec",
  "license": "MIT",
  "homepage": "https://github.com/Dixontec/free-agent",
  "desktopName": "free-agent.desktop",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "server": "node web/start-local.cjs",
    "dist": "electron-builder --linux AppImage",
    "dev:web": "node desktop/dev-run.cjs web",
    "dev:electron": "node desktop/dev-run.cjs electron",
    "test:browser": "node eval/browser-policy-eval.cjs && node eval/rtc-policy-eval.cjs && node eval/matrix-eval.mjs && node eval/run-eval.mjs && node eval/browser-agent-eval.mjs && node eval/browser-dev-eval.cjs && node eval/browser-restart-eval.cjs && node eval/browser-controls-run.cjs && node eval/browser-web-security.cjs && node eval/browser-workspace-eval.cjs && node eval/browser-audit-v5-run.cjs && node eval/browser-fullscreen-web-eval.cjs && node eval/browser-av-eval.cjs",
    "dist:win": "electron-builder --win portable --x64",
    "test:browser:package": "node eval/browser-packaged-eval.cjs",
    "test:browser:portable": "node eval/browser-portable-eval.cjs"
  },
  "build": {
    "appId": "com.dixontec.freeagent",
    "productName": "Free Agent",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "desktop"
    },
    "files": [
      "desktop/**/*",
      "index.html",
      "styles.css",
      "browser-drawer.css",
      "js/**/*",
      "assets/**/*",
      "eval/**/*",
      "!eval/*.md"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/icon.png",
      "category": "Utility",
      "maintainer": "Dixontec",
      "synopsis": "Local-first AI harness",
      "executableName": "free-agent",
      "syncDesktopName": true,
      "artifactName": "Free-Agent-${version}-x86_64.AppImage"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/icon.png",
      "artifactName": "Free-Agent-Portable-${version}-win64.exe"
    },
    "nsis": {
      "artifactName": "Free-Agent-Portable-${version}-win64.exe"
    }
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@ghostery/adblocker": "2.20.1",
    "multicast-dns": "^7.2.5",
    "playwright-core": "^1.64.1",
    "tldts-experimental": "7.4.19",
    "ws": "^8.22.0"
  }
}
