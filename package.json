{
  "name": "free-agent",
  "productName": "Free Agent",
  "version": "1.3.0",
  "description": "Free Agent — local-first AI harness",
  "author": "Dixontec",
  "license": "MIT",
  "homepage": "https://github.com/Dixontec/free-agent",
  "desktopName": "free-agent.desktop",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "voice": "voice-server/.venv/bin/python voice-server/voice_server.py",
    "voice:models": "node scripts/fetch-voice-models.mjs",
    "voice:bundle": "node scripts/build-voice.mjs",
    "stt:bundle": "node scripts/build-stt.mjs",
    "server": "node -e \"const{createStaticServer}=require('./desktop/server');createStaticServer('.').listen(47811,'127.0.0.1',()=>console.log('Free Agent em http://127.0.0.1:47811'))\"",
    "dist": "npm run voice:bundle && npm run stt:bundle && electron-builder --linux AppImage"
  },
  "build": {
    "appId": "com.dixontec.freeagent",
    "productName": "Free Agent",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "desktop"
    },
    "files": [
      "desktop/**/*",
      "index.html",
      "styles.css",
      "js/**/*",
      "assets/**/*",
      "eval/**/*",
      "!eval/*.md"
    ],
    "extraResources": [
      {
        "from": "vendor/voice",
        "to": "voice"
      },
      {
        "from": "voice-server/models",
        "to": "voice/models"
      },
      {
        "from": "vendor/stt",
        "to": "stt"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/icon.png",
      "category": "Utility",
      "maintainer": "Dixontec",
      "synopsis": "Local-first AI harness",
      "executableName": "free-agent",
      "syncDesktopName": true,
      "artifactName": "Free-Agent-${version}-x86_64.AppImage"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/icon.png",
      "artifactName": "Free-Agent-Portable-${version}-win64.exe"
    },
    "nsis": {
      "artifactName": "Free-Agent-Portable-${version}-win64.exe"
    }
  },
  "devDependencies": {
    "@xenova/transformers": "^2.17.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  }
}
